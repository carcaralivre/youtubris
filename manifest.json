{
  "manifest_version": 3,
  "name": "Youtubris",
  "version": "1.9",
  "description": "Limpa o YouTube e guarda quais vídeos você já viu.",
  "browser_specific_settings": {
    "gecko": {
      "id": "youtubris@local",
      "strict_min_version": "142.0",
      "data_collection_permissions": { "required": ["none"] }
    }
  },
  "permissions": ["storage"],
  "host_permissions": ["https://www.youtube.com/*"],
  "content_scripts": [
    {
      "matches": ["https://www.youtube.com/*"],
      "exclude_matches": ["https://www.youtube.com/embed/*", "https://www.youtube.com/tv*"],
      "css": ["styles.css"],
      "js": ["content.js"],
      "run_at": "document_start"
    }
  ],
  "options_ui": { "page": "options.html" },
  "icons": { "48": "icons/youtubris.svg", "96": "icons/youtubris.svg" }
}
